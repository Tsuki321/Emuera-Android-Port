<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.824.0</Version>
    <InformationalVersion>1.824+v24+EMv18+EEv56-android</InformationalVersion>
    <Nullable>disable</Nullable>
    <NoWarn>CS8981;CA1416</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MinorShift.Emuera</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-platform rendering / image handling -->
    <PackageReference Include="SkiaSharp" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Emuera\Properties\lang\emuera-eng.xml" Link="Properties\lang\emuera-eng.xml" />
    <EmbeddedResource Include="..\Emuera\Properties\lang\emuera-zhs.xml" Link="Properties\lang\emuera-zhs.xml" />
  </ItemGroup>

  <!-- Exclude Windows-only _Library files from the Engine project -->
  <ItemGroup>
    <Compile Remove="_Library\WinInput.cs" />
    <Compile Remove="_Library\WinmmTimer.cs" />
    <Compile Remove="_Library\Sound.WMP.cs" />
    <Compile Remove="_Library\Sound.NAudio.cs" />
    <Compile Remove="_Library\NAudio_LoopStream.cs" />
    <Compile Remove="_Library\WebPWrapper.cs" />
    <Compile Remove="_Library\GDI.cs" />
  </ItemGroup>
</Project>

