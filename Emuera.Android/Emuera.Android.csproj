<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.yourname.emuera</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.1-preview</ApplicationDisplayVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Emuera.Engine\Emuera.Engine.csproj" />
    <PackageReference Include="SkiaSharp" Version="2.*" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="..\fixtures\compatibility\CSV\**\*" Link="compatibility\CSV\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\fixtures\compatibility\ERB\**\*" Link="compatibility\ERB\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
